[Unit]
Description=COSMIC desktop system monitor widget
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/sleep 5
ExecStart=/usr/bin/python3 %h/.local/share/cosmic-system-widget/system_widget.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
